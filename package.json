{
	"name": "bbplayer-desktop-root",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check:core": "node scripts/check-core-purity.mjs",
		"check:deps": "syncpack list-mismatches",
		"check:probes": "node scripts/check-probe-syntax.mjs",
		"fix:deps": "syncpack fix-mismatches",
		"format": "oxfmt --write .",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"postinstall": "lefthook install",
		"shots:readme": "node scripts/capture-readme-shots.mjs",
		"shots:readme:dark": "node scripts/capture-readme-shots.mjs --dark",
		"type-check": "tsgo --build --noEmit",
		"verify:backup": "pnpm exec tsx scripts/verify-backup.mts",
		"verify:backup:webdav": "pnpm exec tsx scripts/verify-backup-webdav.mts",
		"verify:desktop": "node scripts/verify-desktop.mjs",
		"verify:desktop:download": "node scripts/verify-download.mjs",
		"verify:desktop:history": "node scripts/verify-desktop-history.mjs",
		"verify:desktop:icons": "node scripts/verify-thumbar-icons.mjs",
		"verify:desktop:import": "node scripts/verify-desktop-import.mjs",
		"verify:desktop:login": "node scripts/verify-desktop-login.mjs",
		"verify:desktop:lyrics-win": "node scripts/verify-desktop-lyrics-window.mjs",
		"verify:desktop:media": "node scripts/verify-desktop-media.mjs",
		"verify:desktop:settings": "node scripts/verify-desktop-settings.mjs",
		"verify:desktop:shared": "node scripts/verify-desktop-shared.mjs",
		"verify:desktop:tour": "node scripts/capture-ui-tour.mjs",
		"verify:desktop:tour:dark": "node scripts/capture-ui-tour.mjs --dark",
		"verify:desktop:ui": "node scripts/verify-desktop-ui.mjs",
		"verify:external-import": "pnpm exec tsx scripts/verify-external-import.mts",
		"verify:login": "pnpm exec tsx scripts/verify-bilibili-login.mts",
		"verify:packaged": "node scripts/verify-packaged.mjs",
		"verify:play-history": "pnpm exec tsx scripts/verify-play-history.mts",
		"verify:shared": "pnpm exec tsx scripts/verify-shared-playlist.mts",
		"verify:sortkey": "pnpm exec tsx scripts/verify-sortkey-interop.mts",
		"verify:win-installer": "node scripts/verify-win-installer.mjs"
	},
	"devDependencies": {
		"@types/node": "^25.2.3",
		"@typescript/native-preview": "beta",
		"lefthook": "^2.1.10",
		"oxfmt": "^0.27.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"syncpack": "^13.0.4",
		"typescript": "~6.0.3"
	},
	"packageManager": "pnpm@11.25.0"
}
